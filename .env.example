# NyayaSetu Environment Configuration
# Copy this file to .env.local (which is gitignored) and fill in values.
# NEVER commit .env.local or any real API keys to version control.

# ─── LLM Provider Configuration ─────────────────────────────────────────────
# Supported providers: "groq" | "gemini"
# Default fallback (when provider is unset or key is missing):
#   NyayaSetu Deterministic Grounded Engine — zero network, 100% provenance.
LLM_PROVIDER=groq

# ─── Groq (Active Provider) ──────────────────────────────────────────────────
# API endpoint: https://api.groq.com/openai/v1  (OpenAI-compatible)
# Verified active models (checked 2026-10-28):
#   openai/gpt-oss-120b   — primary (highest reasoning, ~2.4s, JSON mode)
#   qwen/qwen3.8-27b      — secondary (very fast ~1.5s, JSON mode)
#   openai/gpt-oss-20b    — tertiary (fastest, lighter)
# Obtain a key: https://console.groq.com/keys
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# ─── Gemini (Secondary/Fallback Provider) ────────────────────────────────────
# Set LLM_PROVIDER=gemini to switch to Google Gemini API.
# Verified active models: gemini-2.5-flash | gemini-1.5-flash
# Obtain a key: https://aistudio.google.com/
# GEMINI_API_KEY=

# ─── Application Mode ────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Optional — Phase 2+ Database ────────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/nyayasetu
